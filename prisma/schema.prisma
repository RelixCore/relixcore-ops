// RelixCore Operations — data model
// Core v1: Users/roles, Lead Tracker (CRM), Daily Checklist completions.
// Mirrors the "Lead Tracker (CRM)" tab of RelixCore_Client_Acquisition_System.xlsx
// and the pipeline stages defined in the Agency Operating Manual, Part 5.1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GROWTH_LEAD
  UPWORK_OWNER
  FIVERR_OWNER
  LINKEDIN_OWNER
  COLD_EMAIL_OWNER
  SENIOR_EDITOR
  JUNIOR_EDITOR
  WEB_DEVELOPER
  GRAPHIC_DESIGNER
}

enum Channel {
  UPWORK
  FIVERR
  LINKEDIN_OUTBOUND
  LINKEDIN_INBOUND
  COLD_EMAIL
  DREAM_100
  REFERRAL
  PARTNER_AGENCY
  COMMUNITY
  OTHER
}

enum Vertical {
  YOUTUBE_DOCUMENTARY
  SHORT_FORM
  SAAS_TECH
  REAL_ESTATE
  PODCAST_PRODUCTION
  PERSONAL_BRAND
  ONLINE_COURSE
}

enum PipelineStage {
  LEAD
  QUALIFIED
  DISCOVERY_CALL
  PROPOSAL
  NEGOTIATION
  WON
  ONBOARDING
  DELIVERY
  UPSELL
  REFERRAL
  CASE_STUDY
  LOST
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  title        String?
  // Collection URLs have a partial unique index (see exclusive_animal_avatars
  // migration). Prisma cannot express partial indexes; preserve it in migrations.
  avatarUrl    String?
  createdAt    DateTime @default(now())

  chatMemberships ChatMember[]
  chatMessages ChatMessage[]
  createdChatRooms ChatRoom[]
  driveConnection DriveConnection?

  // Admin-granted CRM edit access independent of role (Role.CRM_EDIT_ROLES
  // already grants this to Platform Owners/Growth Lead/Admin; this override
  // lets an Admin extend edit access to any other member individually).
  crmAccessOverride Boolean @default(false)

  secondaryRoles         UserRole[]
  ownedLeads             Lead[]                 @relation("LeadOwner")
  firstContactLeads      Lead[]                 @relation("LeadFirstContact")
  checklistEntries       ChecklistEntry[]
  activityLogs           ActivityLog[]
  assignedChecklistTasks CustomChecklistTask[]  @relation("ChecklistTaskAssignee")
  createdChecklistTasks  CustomChecklistTask[]  @relation("ChecklistTaskAssignedBy")
  assignedProjects       ChecklistProject[]     @relation("ProjectAssignee")
  createdProjects        ChecklistProject[]     @relation("ProjectAssignedBy")
}

// Additional roles beyond `User.role` (the primary role) — e.g. a Platform
// Owner who also carries editing shifts. Permissions and checklists are the
// union of the primary role and every row here.
model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Lead {
  id                  String        @id @default(cuid())
  leadCode            String        @unique
  companyName         String
  contactName         String?
  channel             Channel
  segment             Vertical?
  stage               PipelineStage @default(LEAD)
  estValue            Float?
  ownerId             String?
  owner               User?         @relation("LeadOwner", fields: [ownerId], references: [id])
  firstContactId      String?
  firstContact        User?         @relation("LeadFirstContact", fields: [firstContactId], references: [id])
  dateFirstContacted  DateTime?
  lastContactDate     DateTime?
  nextAction          String?
  nextActionDate      DateTime?
  nextActionDone      Boolean       @default(false)
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

// One row per (user, date, itemKey) checkbox toggle. itemKey identifies the
// checklist item within that role's template defined in src/lib/checklists.ts.
model ChecklistEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD, local calendar day the checklist belongs to
  itemKey   String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, date, itemKey])
}

// An ad-hoc task added to someone's Daily Checklist for a specific day, on
// top of the fixed role templates in src/lib/checklists.ts. Admins/Growth
// Leads can assign these to any team member (or everyone at once); everyone
// else can only add tasks to their own list. assignedByName is a snapshot so
// the "who assigned it" credit survives the assigner's account being deleted.
model CustomChecklistTask {
  id             String   @id @default(cuid())
  date           String // YYYY-MM-DD, local calendar day it appears on
  text           String
  assigneeId     String
  assignee       User     @relation("ChecklistTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedById   String?
  assignedBy     User?    @relation("ChecklistTaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedByName String
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([assigneeId, date])
}

// A continuous, multi-day piece of work on the Daily Checklist — distinct from
// CustomChecklistTask (which is a single-day, one-off item). Shows as its own
// titled section on the Checklist page every day from startDate until it's
// marked complete, with a green-to-red urgency indicator as dueDate approaches
// and a required daily check-in (see ChecklistProjectCheckIn) separate from
// final completion, so a manager can tell "still working on it" apart from
// "hasn't touched it in days."
model ChecklistProject {
  id             String    @id @default(cuid())
  title          String
  startDate      String // YYYY-MM-DD
  dueDate        String // YYYY-MM-DD
  assigneeId     String
  assignee       User      @relation("ProjectAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedById   String?
  assignedBy     User?     @relation("ProjectAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedByName String
  completed      Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  checkIns ChecklistProjectCheckIn[]

  @@index([assigneeId])
  @@index([dueDate])
}

// One row per (project, date) the assignee confirmed they worked on it.
// Absence of a row for an elapsed active day is a "missed check-in."
model ChecklistProjectCheckIn {
  id        String   @id @default(cuid())
  projectId String
  project   ChecklistProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  checkedAt DateTime @default(now())

  @@unique([projectId, date])
}

enum ActivityAction {
  LOGIN
  LOGOUT
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_DELETED
  TEAM_MEMBER_CREATED
  TEAM_MEMBER_UPDATED
  TEAM_MEMBER_DELETED
  CHECKLIST_ITEM_COMPLETED
  CHECKLIST_ITEM_UNCOMPLETED
  CHECKLIST_TASK_ASSIGNED
  PROJECT_ASSIGNED
  PROJECT_CHECKED_IN
  PROJECT_COMPLETED
  PROJECT_DELETED
  ACTIVITY_LOG_PURGED
}

// Immutable event trail for the Activity Log — one row per meaningful action
// taken in the app. actorName is a snapshot so history survives the actor's
// User row being deleted later.
model ActivityLog {
  id          String         @id @default(cuid())
  actorId     String?
  actor       User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName   String
  action      ActivityAction
  entityType  String?
  entityId    String?
  entityLabel String?
  details     Json?
  createdAt   DateTime       @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

model ChatRoom {
  id String @id @default(cuid())
  name String
  isGeneral Boolean @default(false)
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  members ChatMember[]
  messages ChatMessage[]
  driveWatches DriveWatch[]
}

model ChatMember {
  roomId String
  userId String
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadSeq Int @default(0)
  @@id([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id String @id @default(cuid())
  seq Int @unique @default(autoincrement())
  roomId String
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId String?
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body String
  driveUrl String?
  mentionIds String[] @default([])
  replyToId String?
  replyTo ChatMessage? @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies ChatMessage[] @relation("ChatReplies")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  @@index([roomId, seq])
}

model DriveConnection {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email String
  refreshToken String
  watches DriveWatch[]
}

model DriveWatch {
  id String @id @default(cuid())
  connectionId String
  connection DriveConnection @relation(fields: [connectionId], references: [userId], onDelete: Cascade)
  roomId String
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  folderId String
  folderName String
  includeSubfolders Boolean @default(false)
  snapshot Json?
  lastCheckedAt DateTime?
  lastAttemptAt DateTime @default(now())
  lastError String?
  leaseUntil DateTime?
  leaseToken String?
  @@unique([connectionId, roomId, folderId])
}
